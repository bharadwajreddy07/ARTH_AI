# Docker Compose environment variables (root-level .env)
# Copy this file to .env in repository root before running docker-compose.

JWT_SECRET=replace_with_strong_random_secret
REDIS_URL=redis://redis:6379

# Groq / OpenAI-compatible APIs
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=
HF_TOKEN=
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG tuning
RAG_USE_EMBEDDINGS=false
RAG_TOP_K=4

# FinBERT sentiment (optional)
HF_API_KEY=
FINBERT_MODEL=ProsusAI/finbert

# Market/news providers (optional)
RAPIDAPI_KEY=
NEWS_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
