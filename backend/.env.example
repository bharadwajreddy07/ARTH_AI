# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/arth

# Redis (optional, recommended for production)
# If unset, Arth uses in-memory cache only.
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRE=7d

# AI provider (Groq recommended)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
# Optional alias supported by backend (some users use OPEN_API_KEY)
OPEN_API_KEY=
OPEN_AI_KEY=
OPENAI_KEY=
OPENAI_BASE_URL=
HF_TOKEN=
HUGGINGFACE_API_KEY=

# Model and RAG
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_USE_EMBEDDINGS=false
RAG_TOP_K=4
RAG_MAX_INGEST_DOCS=500
RAG_VECTOR_DIMENSION=256
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=arth_rag_chunks

# Hugging Face / FinBERT sentiment (optional)
HF_API_KEY=
FINBERT_MODEL=ProsusAI/finbert

# Alpha Vantage (free tier: 5 req/min)
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=

# Finnhub
FINNHUB_API_KEY=

# NewsAPI (optional fallback for news feed)
NEWS_API_KEY=
NEWSAPI_KEY=
NEWSDATA_API_KEY=
